# Copy to .env.local and fill in. Never commit .env.local.

# ---------- MySQL ----------
# MYSQL_HOST is the database SERVER hostname, NOT your website domain.
# Copy the real value from hPanel → Databases → Remote MySQL, which prints
# "Our MySQL server hostname is: ...". It looks like srv123.hstgr.io.
# Do not paste the placeholder below — an unresolvable host makes the site fall
# back to bundled seed data instead of failing loudly.
# For local development, add your IP under Databases → Remote MySQL first.
MYSQL_HOST=REPLACE_ME.hstgr.io
MYSQL_PORT=3306
MYSQL_DATABASE=your_database
MYSQL_USER=your_user
MYSQL_PASSWORD=your-password

# ---------- Uploads ----------
# Where uploaded images are written. MUST be outside the app directory —
# deploying replaces that directory and would delete every photo.
# Defaults to ../mariam-uploads relative to the app if unset.
UPLOAD_DIR=/home/uXXXXXXXX/mariam-uploads

# ---------- Site ----------
# Used for canonical URLs, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://mariamautomobile.com
